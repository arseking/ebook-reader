{
  "name": "paper-reader",
  "version": "1.0.0",
  "private": true,
  "description": "A quiet, local-first TXT reader",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "test": "node --experimental-strip-types --test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.5.2",
    "concurrently": "^9.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "cn.paperreader.desktop",
    "productName": "纸间",
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
